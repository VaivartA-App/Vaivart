# Maintainer: Bhavesh Khutwad <https://github.com/Khutwad-Bhavesh/Vaivart>
pkgname=vaivart-git
_pkgname=vaivart
pkgver=1.0.10
pkgrel=1
pkgdesc="Free, offline, open-source file converter optimized for low-end hardware"
arch=('x86_64')
url="https://github.com/Khutwad-Bhavesh/Vaivart"
license=('custom:BSL-1.1')
depends=('gtk3' 'json-glib' 'ffmpeg' 'libreoffice-fresh' 'calibre')
makedepends=('git' 'cmake' 'ninja' 'clang' 'pkgconf' 'json-glib')
provides=('vaivart')
conflicts=('vaivart')
source=("git+https://github.com/Khutwad-Bhavesh/Vaivart.git")
sha256sums=('SKIP')

pkgver() {
  echo "1.0.10"
}

build() {
  cd "$srcdir/Vaivart"
  flutter pub get
  flutter build linux --release
}

package() {
  cd "$srcdir/Vaivart"

  # Install binary bundle files into /usr/lib/vaivart
  install -dm755 "$pkgdir/usr/lib/$_pkgname"
  cp -r build/linux/x64/release/bundle/* "$pkgdir/usr/lib/$_pkgname/"

  # Create executable symlink in /usr/bin/vaivart
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$_pkgname/vaivart" "$pkgdir/usr/bin/vaivart"

  # Install desktop launcher entry
  install -dm755 "$pkgdir/usr/share/applications"
  cat <<EOF > "$pkgdir/usr/share/applications/$_pkgname.desktop"
[Desktop Entry]
Name=Vaivart
Comment=Free, offline file converter.
Exec=/usr/bin/vaivart
Icon=vaivart
Terminal=false
Type=Application
Categories=Utility;FileTools;
EOF

  # Install icons in hicolor format
  for res in 16 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/icon_${res}.png" "$pkgdir/usr/share/icons/hicolor/${res}x${res}/apps/$_pkgname.png"
  done
  # Install license
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
